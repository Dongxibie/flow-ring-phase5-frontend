# pnpm 11 安全机制：默认拒绝 esbuild 等带 install script 的依赖。
# 我们在 Phase 2 已手动跑过
#   node node_modules/.pnpm/esbuild@*/node_modules/esbuild/install.js
# 故显式 allow esbuild 的 install script 跑构建产物下载。
allow-builds=esbuild

# 同时关掉 runDepsStatusCheck 的 freeze（pnpm 11 默认 verify-deps-before-run=true）
verify-deps-before-run=false